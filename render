#!/usr/bin/env python3

import importlib
import os
import shutil
import sys
import glob

import click
import yaml

import backend
from configuration import compute_config_hash, load_yaml, resolve_configuration, deep_merge_dicts


@click.command(help='Render CV template')
@click.option('--configuration', '-c', default='sample', show_default=True, help='Configuration name')
@click.option('--yaml', '-y', 'yaml_path', default='cv.yaml', show_default=True, help='Input data file')
@click.option('--language', '-l', default='en', show_default=True, help='Output language')
@click.option('--out', '-o', 'out_dir', default='build/', show_default=True, help='Output directory')
def main(configuration: str, yaml_path: str, language: str, out_dir: str):
    os.makedirs(out_dir, exist_ok=True)

    root_path = os.path.expanduser(yaml_path)
    data = load_yaml(root_path)

    # Handle optional includes: glob patterns whose YAML contents are merged first.
    include_patterns = data.get('include') or []
    if include_patterns:
        merged_includes: dict = {}
        for pattern in include_patterns:
            for path in sorted(glob.glob(pattern)):
                inc = load_yaml(path)
                merged_includes = deep_merge_dicts(merged_includes, inc)
        # Included content acts as a base; root overrides.
        data = deep_merge_dicts(merged_includes, data)

    configs = data['configurations']
    # Resolve label.yaml path: prefer same directory as this script, fallback to current working dir.
    script_dir = os.path.dirname(os.path.abspath(__file__))
    label_candidates = [os.path.join(script_dir, 'label.yaml'), 'label.yaml']
    label_path = None
    for cand in label_candidates:
        if os.path.exists(cand):
            label_path = cand
            break
    if not label_path:
        raise click.UsageError('label.yaml not found in script directory or current working directory.')
    labels = load_yaml(label_path)

    if configuration not in configs:
        available = ', '.join(sorted(configs.keys()))
        raise click.UsageError(f'Configuration `{configuration}` not found. Available: {available}.')

    build_settings = resolve_configuration(configs, configuration)

    template = build_settings['template']
    dockerfile = build_settings.get('dockerfile')

    # Resolve template & dockerfile paths with additional subdir fallbacks.
    def _resolve_with_candidates(original: str, extra_dirs: list[str]) -> str | None:
        candidates: list[str] = []
        # Original as-is (absolute or relative to CWD).
        candidates.append(original if os.path.isabs(original) else os.path.abspath(original))
        # Relative to script_dir.
        candidates.append(os.path.join(script_dir, original))
        # Under each extra directory inside script_dir.
        for d in extra_dirs:
            candidates.append(os.path.join(script_dir, d, original))
        for c in candidates:
            if os.path.exists(c):
                return os.path.abspath(c)
        return None

    template_path = _resolve_with_candidates(template, ['template'])
    if not template_path:
        raise click.UsageError(f'Template not found. Tried: {template}, script dir, and template subdirectories.')

    if dockerfile:
        dockerfile_path = _resolve_with_candidates(dockerfile, ['backend'])
        if not dockerfile_path:
            raise click.UsageError(f'Dockerfile not found. Tried: {dockerfile}, script dir, and backend subdirectories.')
    else:
        dockerfile_path = None

    environment = build_settings['environment']
    basename = build_settings['basename']
    # Optional: list of project IDs to exclude for this configuration.
    exclude_projects = build_settings.get('exclude-projects') or build_settings.get('exclude_projects') or []
    # Optional: list of education IDs to exclude for this configuration.
    exclude_education = build_settings.get('exclude-education') or build_settings.get('exclude_education') or []
    # Optional: lists of language, skill, and skill group IDs to exclude.
    exclude_languages = build_settings.get('exclude-languages') or build_settings.get('exclude_languages') or []
    exclude_skills = build_settings.get('exclude-skills') or build_settings.get('exclude_skills') or []
    exclude_skill_groups = build_settings.get('exclude-skill-groups') or build_settings.get('exclude_skill_groups') or []

    backend_mod = importlib.import_module(f"backend.{build_settings['backend']}")
    Renderer = getattr(backend_mod, 'Renderer')

    config_hash = compute_config_hash(configuration)
    renderer: backend.BaseRenderer = Renderer(
        data=data['data'],
        labels=labels,
        basename=basename,
        language=language,
        template=template_path,
        dockerfile=dockerfile_path,
        environment=environment,
        out_dir=out_dir,
        configuration=configuration,
        config_hash=config_hash,
        exclude_projects=exclude_projects,
        exclude_education=exclude_education,
        exclude_languages=exclude_languages,
        exclude_skills=exclude_skills,
        exclude_skill_groups=exclude_skill_groups,
        root_dir=os.path.dirname(os.path.abspath(__file__)),
    )

    sample_mode = configuration == 'sample' and data['data']['person']['name']['en'] == 'Alex Falcon'

    if sample_mode:
        i = renderer.expand_intermediate()
        with open('intermediate.example.yaml', 'w', encoding='utf-8') as f:
            yaml.safe_dump(i, f, allow_unicode=True, indent=2, sort_keys=False)

    output_path = renderer.render()

    if sample_mode:
        shutil.copyfile(output_path, f'example-{language}.pdf')


if __name__ == '__main__':
    try:
        main(standalone_mode=True)
    except click.ClickException as e:
        e.show()
        sys.exit(2)
